From 7f2d96e64358882ce5afc0d4d04640eb130037e5 Mon Sep 17 00:00:00 2001
From: frapercan <frapercan1@alum.us.es>
Date: Tue, 27 Oct 2026 15:32:52 +0000
Subject: [PATCH 2/6] Retry failed computing tasks once instead of requeueing
 forever

callback() nacked failed messages with requeue=True unconditionally. A task
that always fails (bad input, a model error) was requeued forever. With
GPUTaskInitializer, which fetches with basic_get until the queue is empty,
the requeued message is fetched again immediately, so the pipeline never
finishes.

Requeue a failed message once, after task_retry_delay seconds (default 5,
so that a brief outage of a remote service can recover). If it fails again
(redelivered), discard it with requeue=False. Verified against RabbitMQ: a
permanently failing task is now attempted twice and removed, instead of
looping.
---
 protein_information_system/config/config.yaml |  4 +
 protein_information_system/tasks/queue.py     | 26 ++++--
 tests/tasks/test_queue_task_initializer.py    | 82 ++++++++++++++++++-
 3 files changed, 106 insertions(+), 6 deletions(-)

diff --git a/protein_information_system/config/config.yaml b/protein_information_system/config/config.yaml
index e41aeb3..51153f3 100644
--- a/protein_information_system/config/config.yaml
+++ b/protein_information_system/config/config.yaml
@@ -11,6 +11,10 @@ binaries_path: '../binaries'
 # Monitoring interval in seconds (for processes that require periodic checks).
 monitor_interval: 10 # ⚠️ IMPORTANT: Low values as 1 can cause execution problems.
 
+# Seconds to wait before retrying a failed task once. A task that fails again is
+# discarded.
+task_retry_delay: 5
+
 # Path to save logs, set False to disable the option
 log_path: '~/data/logs'
 
diff --git a/protein_information_system/tasks/queue.py b/protein_information_system/tasks/queue.py
index 573b5f1..6407f16 100644
--- a/protein_information_system/tasks/queue.py
+++ b/protein_information_system/tasks/queue.py
@@ -347,11 +347,27 @@ class QueueTaskInitializer(BaseTaskInitializer):
             )
             ch.basic_ack(delivery_tag=method.delivery_tag)
         except Exception as e:
-            self.logger.error(
-                f"Error while processing message in the computing queue: {e}",
-                exc_info=True
-            )
-            ch.basic_nack(delivery_tag=method.delivery_tag, requeue=True)
+            # Retry once, after task_retry_delay seconds so that a brief outage of a
+            # remote service can recover. A message that fails again is discarded:
+            # requeueing it forever loops on permanent errors (with basic_get it is
+            # fetched again immediately). A message redelivered after a consumer crash
+            # also counts as a retry.
+            if getattr(method, "redelivered", False):
+                self.logger.error(
+                    f"Error while processing message in the computing queue after a retry: {e}. "
+                    "Discarding the message.",
+                    exc_info=True
+                )
+                ch.basic_nack(delivery_tag=method.delivery_tag, requeue=False)
+            else:
+                delay = float(self.conf.get('task_retry_delay', 5))
+                self.logger.error(
+                    f"Error while processing message in the computing queue: {e}. "
+                    f"Retrying once in {delay:g} s.",
+                    exc_info=True
+                )
+                time.sleep(delay)
+                ch.basic_nack(delivery_tag=method.delivery_tag, requeue=True)
 
     @abstractmethod
     def enqueue(self):
diff --git a/tests/tasks/test_queue_task_initializer.py b/tests/tasks/test_queue_task_initializer.py
index 9b1b578..16ff0a4 100644
--- a/tests/tasks/test_queue_task_initializer.py
+++ b/tests/tasks/test_queue_task_initializer.py
@@ -21,7 +21,8 @@ class DummyTask(QueueTaskInitializer):
 def make_task(**conf):
     """Build a task without running __init__, which connects to RabbitMQ and the DB."""
     task = DummyTask.__new__(DummyTask)
-    task.conf = {"rabbitmq_host": "localhost", "rabbitmq_user": "guest", "rabbitmq_password": "guest", **conf}
+    task.conf = {"rabbitmq_host": "localhost", "rabbitmq_user": "guest", "rabbitmq_password": "guest",
+                 "task_retry_delay": 0, **conf}
     task.logger = logging.getLogger("test_queue_task_initializer")
     task.stop_event = multiprocessing.Event()
     task.processes = []
@@ -107,3 +108,82 @@ def test_successful_pipeline_runs_post_processing():
     task.start()
 
     assert calls == ["post"]
+
+
+# ---------------------------------------------------------------------------
+# Computing-queue retries
+# ---------------------------------------------------------------------------
+
+class FakeChannel:
+    def __init__(self):
+        self.acks = []
+        self.nacks = []
+        self.published = []
+
+    def basic_ack(self, delivery_tag):
+        self.acks.append(delivery_tag)
+
+    def basic_nack(self, delivery_tag, requeue):
+        self.nacks.append((delivery_tag, requeue))
+
+    def basic_publish(self, exchange, routing_key, body):
+        self.published.append((routing_key, body))
+
+
+class Method:
+    def __init__(self, delivery_tag=1, redelivered=False):
+        self.delivery_tag = delivery_tag
+        self.redelivered = redelivered
+
+
+def _failing_process(target):
+    raise RuntimeError("model crashed")
+
+
+def test_failed_message_is_retried_once():
+    import pickle
+    task = make_task()
+    task.process = _failing_process
+    ch = FakeChannel()
+
+    task.callback(ch, Method(redelivered=False), None, pickle.dumps({"x": 1}))
+
+    assert ch.nacks == [(1, True)]
+
+
+def test_retry_waits_task_retry_delay(monkeypatch):
+    import pickle
+    import protein_information_system.tasks.queue as queue_module
+
+    slept = []
+    monkeypatch.setattr(queue_module.time, "sleep", slept.append)
+    task = make_task(task_retry_delay=7)
+    task.process = _failing_process
+    ch = FakeChannel()
+
+    task.callback(ch, Method(redelivered=False), None, pickle.dumps({"x": 1}))
+
+    assert slept == [7.0]
+    assert ch.nacks == [(1, True)]
+
+
+def test_failed_message_is_discarded_after_retry():
+    import pickle
+    task = make_task()
+    task.process = _failing_process
+    ch = FakeChannel()
+
+    task.callback(ch, Method(redelivered=True), None, pickle.dumps({"x": 1}))
+
+    assert ch.nacks == [(1, False)]
+
+
+def test_successful_message_is_published_and_acked():
+    import pickle
+    task = make_task()
+    ch = FakeChannel()
+
+    task.callback(ch, Method(), None, pickle.dumps({"x": 1}))
+
+    assert ch.acks == [1]
+    assert ch.published[0][0] == task.inserting_queue
