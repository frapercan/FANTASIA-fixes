From 28c55d1c4f6a3bd3424701270bc26662110a5f09 Mon Sep 17 00:00:00 2001
From: frapercan <frapercan1@alum.us.es>
Date: Tue, 27 Oct 2026 15:31:04 +0000
Subject: [PATCH 1/6] Raise post-processing errors when the pipeline succeeded

QueueTaskInitializer.start() ran post_processing() in a finally block and
only logged its exceptions, so a task whose post-processing failed still
returned normally. FANTASIA, for example, exited with 0 and an incomplete
summary.csv.

Raise the post-processing error when the pipeline itself completed. If the
pipeline already failed, keep logging the post-processing error and let the
original pipeline error propagate, so it is not masked.
---
 protein_information_system/tasks/queue.py  | 11 +++
 tests/tasks/__init__.py                    |  0
 tests/tasks/test_queue_task_initializer.py | 89 ++++++++++++++++++++++
 3 files changed, 100 insertions(+)
 create mode 100644 tests/tasks/__init__.py
 create mode 100644 tests/tasks/test_queue_task_initializer.py

diff --git a/protein_information_system/tasks/queue.py b/protein_information_system/tasks/queue.py
index 6f883d8..7a230b8 100644
--- a/protein_information_system/tasks/queue.py
+++ b/protein_information_system/tasks/queue.py
@@ -117,8 +117,14 @@ class QueueTaskInitializer(BaseTaskInitializer):
         - Enqueue tasks
         - Launch workers and wait for completion
         - Run post-processing hook
+
+        Raises:
+            Exception: Any error from the pipeline. An error from the post-processing
+                hook is raised when the pipeline itself succeeded; if the pipeline
+                failed, it is logged and the pipeline error is raised instead.
         """
         self.logger.info("Starting the task processing pipeline.")
+        completed = False
         try:
             self.setup_rabbitmq()
             self.logger.info("RabbitMQ set up. Enqueueing tasks…")
@@ -126,6 +132,7 @@ class QueueTaskInitializer(BaseTaskInitializer):
             self.logger.info("Tasks enqueued. Starting workers…")
             self.start_workers()
             self.logger.info("All workers finished. Running post-processing hook…")
+            completed = True
         except Exception as e:
             self.logger.error("Error in task processing pipeline: %s", e, exc_info=True)
             raise
@@ -137,6 +144,10 @@ class QueueTaskInitializer(BaseTaskInitializer):
                 self.logger.info("Post-processing hook completed.")
             except Exception as e:
                 self.logger.error("Post-processing hook failed: %s", e, exc_info=True)
+                # Only surface it when the pipeline itself succeeded; otherwise the
+                # original pipeline error is already propagating.
+                if completed:
+                    raise
 
     def start_workers(self):
         """
