+        self._check_failed_tasks()
+
+    def _record_task_failure(self):
+        """Count a task discarded after failing (safe across worker processes)."""
+        counter = getattr(self, 'failed_tasks', None)
+        if counter is not None:
+            with counter.get_lock():
+                counter.value += 1
+
+    def _check_failed_tasks(self):
+        """Fail the pipeline if tasks were discarded, unless disabled in the configuration."""
+        counter = getattr(self, 'failed_tasks', None)
+        failed = counter.value if counter is not None else 0
+        if not failed:
+            return
+        message = f"{failed} task(s) failed and were discarded; see the errors above."
+        if self.conf.get('fail_on_task_errors', True):
+            raise TaskFailuresError(message)
+        self.logger.warning("%s Continuing because fail_on_task_errors is false.", message)
+
     def start_workers(self):
