+# ---------------------------------------------------------------------------
+# Failed tasks
+# ---------------------------------------------------------------------------
+
+def _failing_store_entry(record):
+    raise RuntimeError("cannot store")
+
+
+def test_discarded_tasks_fail_the_pipeline_after_post_processing():
+    import pickle
+    task = make_task()
+    calls = []
+    task.post_processing = lambda: calls.append("post")
+    task.process = _failing_process
+    task.store_entry = _failing_store_entry
+
+    def workers():
+        ch = FakeChannel()
+        task.callback(ch, Method(redelivered=False), None, pickle.dumps(1))  # retried: not a failure
+        task.callback(ch, Method(redelivered=True), None, pickle.dumps(1))  # discarded
+        task.db_inserter_callback(ch, Method(), None, pickle.dumps(1))  # discarded
+
+    task.start_workers = workers
+
+    with pytest.raises(TaskFailuresError, match="2 task"):
+        task.start()
+    assert calls == ["post"]
+
+
+def test_discarded_tasks_only_warn_when_disabled(caplog):
+    import pickle
+    task = make_task(fail_on_task_errors=False)
+    task.post_processing = lambda: None
+    task.store_entry = _failing_store_entry
+    task.start_workers = lambda: task.db_inserter_callback(FakeChannel(), Method(), None, pickle.dumps(1))
+
+    with caplog.at_level(logging.WARNING):
+        task.start()
+    assert "1 task(s) failed" in caplog.text
+
+
+def test_value_error_in_process_is_a_skip_not_a_failure():
+    import pickle
+    task = make_task()
+
+    def skip(target):
+        raise ValueError("nothing to do")
+
+    task.process = skip
+    ch = FakeChannel()
+    task.callback(ch, Method(), None, pickle.dumps(1))
+
+    assert ch.acks == [1]
+    assert task.failed_tasks.value == 0
+
+
+def _increment_in_child(task):
+    task._record_task_failure()
+
+
+def test_failure_counter_is_shared_with_worker_processes():
+    task = make_task()
+    procs = [multiprocessing.Process(target=_increment_in_child, args=(task,)) for _ in range(3)]
+    for p in procs:
+        p.start()
+    for p in procs:
+        p.join()
+    assert task.failed_tasks.value == 3
